# Copy to .env and fill in. Never commit .env.
# Create a bot with @BotFather and get your chat id from @userinfobot (or /getUpdates).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional: where the SQLite state file lives (default: state/seen.sqlite)
# CARBOT_STATE_PATH=state/seen.sqlite
